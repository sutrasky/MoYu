new file mode 100644
index 0000000..6af837e
--- /dev/null
+++ b/src/executor/stop-proof.ts
@@ -0,0 +1,115 @@
+/** Durable stop proof shared by the live executor, restart recovery and replacement admission. */
+import { readFileSync } from 'node:fs'
+import type { Assignment, Ticket } from '../core/index.ts'
+import { KV } from '../kv.ts'
+
+export interface ProcessIdentity {
+  pid: number
+  /** `/proc/<pid>/stat` field 22: distinguishes a reused PID after a restart. */
+  startTime: string
+  /** The cgroup observed when the identity was recorded, for ownership comparison. */
+  cgroup?: string
+}
+
+export interface StopProof {
+  ticketId: string
+  assignmentId: string
+  leaseId?: string
+  fencingToken?: string
+  jobs: { id: string; name: string }[]
+  processes: ProcessIdentity[]
+  state: 'unproven' | 'proven'
+  at: string
+}
+
+type Store = { get<V>(key: string): V | undefined; set<V>(key: string, value: V): void }
+
+/** Read a PID identity without relying on a short process-tree snapshot: an
+ * orphan reparented to PID 1 still has the same PID and start time. */
+export function readProcessIdentity(pid: number): ProcessIdentity | null {
+  try {
+    const stat = readFileSync(`/proc/${pid}/stat`, 'utf8')
+    // The command name can contain spaces/parentheses; fields after the last ')'.
+    const tail = stat.slice(stat.lastIndexOf(')') + 2).split(' ')
+    const startTime = tail[19]
+    if (!startTime) return { pid, startTime: 'unknown' }
+    let cgroup: string | undefined
+    try { cgroup = readFileSync(`/proc/${pid}/cgroup`, 'utf8').trim().split('\n')[0]?.split(':').at(-1) } catch { /* optional */ }
+    return { pid, startTime, ...(cgroup ? { cgroup } : {}) }
+  } catch (error) {
+    if ((error as NodeJS.ErrnoException).code === 'ENOENT') return null
+    return { pid, startTime: 'unknown' }
+  }
+}
+
+/** true = still the same process, false = gone/reused, undefined = cannot tell. */
+export function identityAlive(identity: ProcessIdentity): boolean | undefined {
+  const current = readProcessIdentity(identity.pid)
+  if (!current) return false
+  if (identity.startTime === 'unknown' || current.startTime === 'unknown') return undefined
+  if (current.startTime !== identity.startTime) return false
+  if (identity.cgroup && current.cgroup && current.cgroup !== identity.cgroup) return undefined
+  return true
+}
+
+export function readStopProof(store: Store, ticketId: string, assignmentId: string): StopProof | undefined {
+  return store.get<StopProof>(KV.admission.stopProof(ticketId, assignmentId))
+}
+
+/** Record the identity before stopping. An existing unproven record is never overwritten. */
+export function recordStopProof(store: Store, ticket: Ticket, assignment: Assignment,
+  jobs: { id: string; name: string }[], processes: ProcessIdentity[]): StopProof {
+  const existing = readStopProof(store, ticket.id, assignment.id)
+  if (existing && existing.state === 'unproven') return existing
+  const proof: StopProof = {
+    ticketId: ticket.id,
+    assignmentId: assignment.id,
+    ...ticket.admission ? { leaseId: ticket.admission.leaseId, fencingToken: ticket.admission.fencingToken } : {},
+    jobs,
+    processes,
+    state: 'unproven',
+    at: new Date().toISOString(),
+  }
+  store.set(KV.admission.stopProof(ticket.id, assignment.id), proof)
+  return proof
+}
+
+/** A stop that resolved with no remaining identity is complete. */
+export function completeStopProof(store: Store, proof: StopProof): void {
+  store.set(KV.admission.stopProof(proof.ticketId, proof.assignmentId), { ...proof, state: 'proven', at: new Date().toISOString() })
+}
+
+/**
+ * Mark proven only when every recorded job is gone and every process identity
+ * is gone or reused. Empty job/process identity is unknown; only the explicit
+ * post-stop completion above may settle it.
+ */
+export function settleStopProof(store: Store, proof: StopProof, liveJobs: { id: string }[]): boolean {
+  const jobsGone = proof.jobs.every(job => !liveJobs.some(live => live.id === job.id))
+  let processesGone = true
+  for (const identity of proof.processes) {
+    const alive = identityAlive(identity)
+    if (alive !== false) { processesGone = false; break }
+  }
+  const exposed = proof.jobs.length + proof.processes.length > 0
+  const proven = exposed && jobsGone && processesGone
+  if (proven) store.set(KV.admission.stopProof(proof.ticketId, proof.assignmentId), { ...proof, state: 'proven', at: new Date().toISOString() })
+  return proven
+}
+
+/**
+ * A replacement may proceed only when every ended Assignment of the Ticket has a
+ * durable proof whose identities are gone. An admitted Ticket without a proof is
+ * unknown and blocks; a live or unreadable identity also blocks.
+ */
+export function replacementBlocked(store: Store, ticket: Ticket): boolean {
+  for (const assignment of ticket.assignments) {
+    if (assignment.state !== 'ended') continue
+    const proof = readStopProof(store, ticket.id, assignment.id)
+    if (!proof) { if (ticket.admission) return true; continue }
+    // Only a completed stop callback may settle an unproven proof. A restart
+    // with an empty job registry cannot prove that the old job exited.
+    if (proof.state !== 'proven') return true
+  }
+  return false
+}
