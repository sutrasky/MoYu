@@ -0,0 +1,30 @@
+import { spawn } from 'node:child_process'
+import { describe, expect, it } from 'vitest'
+import { readProcessIdentity, identityAlive, recordStopProof, replacementBlocked } from '../src/executor/stop-proof.ts'
+import type { Assignment, Ticket } from '../src/core/index.ts'
+
+function store() {
+  const values = new Map<string, unknown>()
+  return { get<V>(key: string): V | undefined { return values.get(key) as V | undefined },
+    set<V>(key: string, value: V): void { values.set(key, value) } }
+}
+const ticket: Ticket = { id: 't1', title: 'x', decisionId: 'd', mandate: {} as never, channels: [], inputs: [], undelivered: [],
+  createdAt: '', updatedAt: '', origin: { triggerId: 'g', triggerIds: ['g'] },
+  assignments: [{ id: 'a1', state: 'ended', createdAt: '' }], admission: { leaseId: 'l', fencingToken: '1' } }
+const assignment: Assignment = { id: 'a1', state: 'ended', createdAt: '' }
+
+describe('recovery red evidence', () => {
+  it('still blocks after the recorded real process exited, because no authoritative stop completion exists', async () => {
+    const s = store()
+    const child = spawn('sleep', ['10'], { stdio: 'ignore' })
+    const identity = readProcessIdentity(child.pid!)!
+    recordStopProof(s, ticket, assignment, [{ id: 'job-1', name: 'sleep' }], [identity])
+    expect(identityAlive(identity)).toBe(true)
+    expect(replacementBlocked(s, ticket)).toBe(true)
+    child.kill('SIGKILL')
+    await new Promise(resolve => setTimeout(resolve, 150))
+    expect(identityAlive(identity)).toBe(false)
+    // The current implementation cannot settle without the original stop callback.
+    expect(replacementBlocked(s, ticket)).toBe(true)
+  })
+})
diff --git a/tests/stop-proof.spec.ts b/tests/stop-proof.spec.ts
new file mode 100644
index 0000000..20fe54d
--- /dev/null
+++ b/tests/stop-proof.spec.ts
@@ -0,0 +1,66 @@
+import { describe, expect, it } from 'vitest'
+import { spawn } from 'node:child_process'
+import { completeStopProof, identityAlive, readProcessIdentity, readStopProof, recordStopProof, replacementBlocked, settleStopProof } from '../src/executor/stop-proof.ts'
+import type { Assignment, Ticket } from '../src/core/index.ts'
+
+function store() {
+  const values = new Map<string, unknown>()
+  return { values, get<V>(key: string): V | undefined { return values.get(key) as V | undefined },
+    set<V>(key: string, value: V): void { values.set(key, value) } }
+}
+const ticket = (admission?: { leaseId: string; fencingToken: string }): Ticket => ({
+  id: 't1', title: 'x', decisionId: 'd', mandate: {} as never, channels: [], inputs: [], undelivered: [],
+  createdAt: '', updatedAt: '', origin: { triggerId: 'g', triggerIds: ['g'] },
+  assignments: [{ id: 'a1', state: 'ended', createdAt: '' }], ...(admission ? { admission } : {}),
+})
+const assignment: Assignment = { id: 'a1', state: 'ended', createdAt: '' }
+
+describe('durable stop proof', () => {
+  it('records the old identity before stop and only proves it after the job and pid are gone', () => {
+    const s = store()
+    const proof = recordStopProof(s, ticket({ leaseId: 'l1', fencingToken: '1' }), assignment,
+      [{ id: 'job-1', name: 'build' }], [readProcessIdentity(process.pid)!])
+    expect(proof.state).toBe('unproven')
+    expect(readStopProof(s, 't1', 'a1')?.fencingToken).toBe('1')
+    expect(settleStopProof(s, proof, [{ id: 'job-1' }])).toBe(false)
+    expect(settleStopProof(s, proof, [])).toBe(false)
+    const gone = recordStopProof(s, ticket({ leaseId: 'l2', fencingToken: '2' }), { ...assignment, id: 'a2' }, [], [{ pid: 999999, startTime: '1' }])
+    expect(settleStopProof(s, gone, [])).toBe(true)
+  })
+
+  it('settles A without touching an unrelated B that is still running', () => {
+    const s = store()
+    const a = recordStopProof(s, ticket({ leaseId: 'a', fencingToken: '1' }), assignment, [], [])
+    const b = recordStopProof(s, ticket({ leaseId: 'b', fencingToken: '2' }), { ...assignment, id: 'b1' }, [{ id: 'job-b', name: 'b' }], [])
+    completeStopProof(s, a)
+    expect(replacementBlocked(s, ticket({ leaseId: 'a', fencingToken: '1' }))).toBe(false)
+    expect(replacementBlocked(s, { ...ticket({ leaseId: 'b', fencingToken: '2' }), assignments: [{ id: 'b1', state: 'ended', createdAt: '' }] })).toBe(true)
+    expect(b.state).toBe('unproven')
+  })
+
+  it('blocks replacement when the identity is missing or a recorded pid survives a restart', () => {
+    const s = store()
+    const admitted = ticket({ leaseId: 'l1', fencingToken: '1' })
+    expect(replacementBlocked(s, admitted)).toBe(true)
+    const empty = recordStopProof(s, admitted, assignment, [], [])
+    expect(replacementBlocked(s, admitted)).toBe(true)
+    completeStopProof(s, empty)
+    expect(replacementBlocked(s, admitted)).toBe(false)
+    const other = store()
+    recordStopProof(other, ticket(), assignment, [{ id: 'job-2', name: 'x' }], [])
+    expect(replacementBlocked(other, ticket())).toBe(true)
+  })
+})
+
+
+describe('process identity across an orphan', () => {
+  it('keeps a real orphan alive after its parent exits and detects the same start time', async () => {
+    const child = spawn('sleep', ['10'], { detached: false, stdio: 'ignore' })
+    const identity = readProcessIdentity(child.pid!)!
+    expect(identity.startTime).not.toBe('unknown')
+    expect(identityAlive(identity)).toBe(true)
+    process.kill(child.pid!, 'SIGKILL')
+    await new Promise(resolve => setTimeout(resolve, 150))
+    expect(identityAlive(identity)).toBe(false)
+  })
+})
